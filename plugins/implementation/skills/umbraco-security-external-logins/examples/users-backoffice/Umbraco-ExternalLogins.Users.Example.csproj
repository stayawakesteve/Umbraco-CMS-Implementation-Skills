<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    VALIDATION-ONLY example project for the umbraco-security-external-logins skill, users approach.

    Compiles the skill's assets/BackOfficeExternalLogin.cs, projected into obj/ at build time with
    its placeholders substituted (see .generate.json), and embeds the projected umbraco-package.json
    so ExampleHostWiring can serve it as a package manifest. The reference instance
    (Umbraco-CMS.Skills) references this project, and ExternalLoginsUsersTests asserts the result
    over HTTP. Not shipped to users; not part of any plugin.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.ExternalLogins.Users</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <!-- The shared GenerateSkillAssets target embeds only .cshtml and .xml. The manifest is JSON, so
       it is embedded here, after generation, under its bare file name. -->
  <Target Name="EmbedSkillManifest" AfterTargets="GenerateSkillAssets">
    <ItemGroup>
      <SkillManifestResource Include="$(IntermediateOutputPath)skill-assets/umbraco-package.json" />
      <EmbeddedResource Include="@(SkillManifestResource)" LogicalName="umbraco-package.json" />
    </ItemGroup>
  </Target>

</Project>
