<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    VALIDATION-ONLY example project for the umbraco-sitemap skill.

    It is a compilable projection of the skill's Approach A assets
    (SitemapController + SitemapComposer + SitemapCacheInvalidator) with the
    <Namespace> placeholder substituted for a fixed namespace. The reference
    instance (Umbraco-CMS.Skills) references this project so the code is compiled
    and loaded in-process, and Umbraco-CMS.Skills.TestHost asserts /sitemap.xml over
    HTTP. Regenerate the .cs files from the skill's assets/ with
    scripts/generate-examples.sh. Not shipped to users; not part of any plugin.

    Razor SDK so the controller registers as an application part.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.Sitemap</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web.Website pulls in Web.Common + Core + Infrastructure transitively, covering the
         Umbraco.Cms.* namespaces the assets use. Version comes from the repo-root
         Directory.Packages.props, so it stays in lockstep with the Umbraco the host loads. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

</Project>
