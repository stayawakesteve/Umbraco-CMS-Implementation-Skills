<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VALIDATION-ONLY example project for umbraco-custom-error-pages Approach B (config-based 404).

    Loaded by SITE 2 (Umbraco-CMS.Skills.Blank, no starter kit). That is not a preference: Approach A
    calls SetContentLastChanceFinder, which is AddUnique<IContentLastChanceFinder, T>() and therefore
    REPLACES Umbraco's own ContentFinderByConfigured404 — which is Approach B's entire implementation.
    Put both in one host and whichever registers last silently wins.

    Approach B ships no C# of its own: Umbraco's built-in finder does the work, and the skill's
    contribution is a Document Type, a template and a config block. Everything in this folder is
    example-only scaffolding standing in for the backoffice steps and the appsettings edit a user makes
    by hand.

    Plain Microsoft.NET.Sdk, NOT Sdk.Razor: the template is installed by the package migration and
    compiled at runtime by the host, exactly as a real user's template is.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.CustomErrorPagesApproachB</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static seeding helpers. Referenced as a PROJECT, not linked as source: linking compiled
         the same types into every consumer, and because the host references the examples the
         compiler saw duplicates and warned (CS0436). -->
    <ProjectReference Include="../../../../../../ExampleFixtures.Shared/ExampleFixtures.Shared.csproj" />
  </ItemGroup>

</Project>
