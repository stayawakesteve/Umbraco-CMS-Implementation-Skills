<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    VALIDATION-ONLY example project for the umbraco-custom-error-pages skill.

    It is a compilable projection of the skill's Approach A 404 asset
    (PageNotFoundContentFinder + composer) and the shared 500 asset (ErrorController), with the
    <Namespace> and <ErrorPageAlias> placeholders substituted for fixed values. The reference
    instance (Umbraco-CMS.Skills) references this project so the code is compiled and loaded
    in-process, and Umbraco-CMS.Skills.TestHost asserts the 404 and 500 responses over HTTP.
    Regenerate the .cs files from the skill's assets/ with scripts/generate-examples.sh.
    Not shipped to users; not part of any plugin.

    ExampleHostWiring.cs is NOT generated from assets/ — it is this example's own harness: the
    host wiring the skill's reference tells users to add by hand (UseExceptionHandler +
    ReservedPaths), plus a deliberately-throwing endpoint so a 500 can be provoked on demand.

    Razor SDK so the controller registers as an application part.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.CustomErrorPages</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web.Website pulls in Web.Common + Core + Infrastructure transitively, covering the
         Umbraco.Cms.* namespaces the assets use. Version comes from the repo-root
         Directory.Packages.props, so it stays in lockstep with the Umbraco the host loads. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

</Project>
