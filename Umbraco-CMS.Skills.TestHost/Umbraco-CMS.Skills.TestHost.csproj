<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Umbraco_CMS.Skills.TestHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco-CMS.Skills\Umbraco-CMS.Skills.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Each skill's tests live next to the example they exercise, but compile into THIS assembly.
      That's deliberate: Umbraco keeps process-wide static state, so every fixture has to share one
      host (see ReferenceSiteFixture) — a test project per skill would boot an Umbraco each.
      So: feature-sliced on disk, single assembly at build time.

      Adding a skill needs no change here. bin/obj are excluded because the SDK copies these files
      into build output, and compiling those copies would duplicate every fixture.
    -->
    <Compile Include="..\plugins\**\examples\*\*Tests.cs"
             Exclude="..\plugins\**\bin\**;..\plugins\**\obj\**" />
  </ItemGroup>

</Project>
